# ---- Servidor ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Banco (MySQL) ----
DATABASE_URL="mysql://root:aluno@localhost:3306/nebulosabd"

# ---- Autenticação (jose / JWT em cookie) ----
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
